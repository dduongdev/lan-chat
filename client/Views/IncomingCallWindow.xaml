<Window x:Class="LanChat.Client.Views.IncomingCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incoming Call"
        Width="320"
        Height="150"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#1B2220">
    <Border BorderBrush="#2F3E38" BorderThickness="1" CornerRadius="8" Margin="8">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Text="Incoming video call"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="ContentText"
                       Grid.Row="1"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="#C8D3CE"
                       FontSize="13"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Từ chối"
                        Width="86"
                        Height="32"
                        Margin="0,0,8,0"
                        Background="#3D3D3D"
                        Foreground="White"
                        BorderThickness="0"
                        Click="RejectButton_Click"/>
                <Button Content="Chấp nhận"
                        Width="92"
                        Height="32"
                        Background="#2B7D5D"
                        Foreground="White"
                        BorderThickness="0"
                        Click="AcceptButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
