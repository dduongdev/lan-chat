<Window x:Class="LanChat.Client.Views.CreateGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo nhóm mới" Height="400" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Tạo nhóm chat" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Tên nhóm" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="2" x:Name="GroupNameBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="3" Text="Thêm thành viên" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" VerticalAlignment="Top"/>
        <ListBox Grid.Row="3" x:Name="UsersListBox" Margin="0,24,0,16" Background="{StaticResource BgMediumBrush}" BorderBrush="#C8C5BB" BorderThickness="1"
                 SelectionMode="Multiple" Foreground="{StaticResource TextPrimaryBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Padding="8,4"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Hủy" Grid.Column="0" Click="CancelButton_Click" Background="{StaticResource BgMediumBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="0,10" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Tạo" Grid.Column="2" Click="CreateButton_Click" Style="{StaticResource PrimaryButton}" Padding="0,10"/>
        </Grid>
    </Grid>
</Window>
