<Window x:Class="LanChat.Client.Views.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Call" Height="520" Width="760"
        MinHeight="420" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        Background="#121816">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CameraButton" Content="Camera On" Width="96" Height="34" Margin="0,0,8,0"
                        Background="#24483F" Foreground="White" BorderThickness="0"
                        Click="CameraButton_Click"/>
                <Button x:Name="MicButton" Content="Mic Off" Width="82" Height="34" Margin="0,0,8,0"
                        Background="#3D3D3D" Foreground="White" BorderThickness="0"
                        Click="MicButton_Click"/>
                <Button Content="End" Width="92" Height="34"
                        Background="#B83232" Foreground="White" BorderThickness="0"
                        Click="EndButton_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Video Call" Foreground="White"
                           FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Text="Connecting..." Foreground="#A9B8AF"
                           FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#050807" BorderBrush="#31423A"
                    BorderThickness="1" CornerRadius="6" Margin="0,0,12,0">
                <Grid>
                    <Image x:Name="RemoteImage" Stretch="Uniform"/>
                    <TextBlock x:Name="RemotePlaceholder" Text="Waiting for remote video"
                               Foreground="#A9B8AF" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#050807" BorderBrush="#31423A"
                    BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Image x:Name="LocalImage" Stretch="Uniform"/>
                    <Border Background="#80000000" VerticalAlignment="Bottom" Padding="8">
                        <TextBlock x:Name="LocalVideoLabel" Text="Local video" Foreground="White" FontSize="12"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Camera" Foreground="#A9B8AF" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="CameraDeviceBox" Grid.Column="1" Height="28"
                      SelectionChanged="CameraDeviceBox_SelectionChanged"/>

            <TextBlock Grid.Column="2" Text="Mic" Foreground="#A9B8AF" FontSize="12"
                       VerticalAlignment="Center" Margin="12,0,8,0"/>
            <ComboBox x:Name="MicrophoneDeviceBox" Grid.Column="3" Height="28"
                      SelectionChanged="MicrophoneDeviceBox_SelectionChanged"/>

            <TextBlock Grid.Column="4" Margin="12,0,0,0" Foreground="#A9B8AF" FontSize="12"
                       VerticalAlignment="Center"
                       Text="UDP P2P · MJPEG video · PCM16 audio"/>
        </Grid>
    </Grid>
</Window>
