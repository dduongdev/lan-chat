<Window x:Class="LanChat.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanChat — Sign In" 
        Height="540" Width="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <StackPanel VerticalAlignment="Center" Margin="30">
                <!-- Logo / Title -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                    <TextBlock Text="💬" FontSize="28" Foreground="White" Margin="0,0,10,0"/>
                    <TextBlock Text="LanChat" FontSize="28" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <TextBlock Text="🛡" FontSize="16" Foreground="{StaticResource SidebarTextSecondaryBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Mã hóa AES" FontSize="14" Foreground="White"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <TextBlock Text="💬" FontSize="16" Foreground="{StaticResource SidebarTextSecondaryBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Trò chuyện 1-1" FontSize="14" Foreground="White"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <TextBlock Text="📄" FontSize="16" Foreground="{StaticResource SidebarTextSecondaryBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Truyền tập tin" FontSize="14" Foreground="White"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <TextBlock Text="👥" FontSize="16" Foreground="{StaticResource SidebarTextSecondaryBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Phòng chat &amp; Trạng thái" FontSize="14" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Right Column -->
        <Border Grid.Column="1" Background="{StaticResource BgDarkBrush}">
            <Border Background="{StaticResource BgMediumBrush}" CornerRadius="20" Margin="40" Padding="30">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Kết nối" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <!-- Server IP (Hidden for exact design match, but we need it. I'll make it smaller or remove it and hardcode. Let's keep it but stylize it) -->
                    <!-- Username -->
                    <TextBlock Text="Tên người dùng" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <TextBox x:Name="UsernameBox" Style="{StaticResource DarkTextBox}" Background="Transparent" BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1" Margin="0,0,0,20"/>

                    <!-- Password -->
                    <TextBlock Text="Mật khẩu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource DarkPasswordBox}" Background="Transparent" BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1" Margin="0,0,0,30"/>

                    <!-- Login & Register Buttons -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button x:Name="LoginButton" Grid.Column="0" Content="Đăng nhập" Style="{StaticResource PrimaryButton}" Background="{StaticResource PrimaryDarkBrush}" Click="LoginButton_Click" IsEnabled="False"/>
                        
                        <Button x:Name="RegisterButton" Grid.Column="2" Content="Đăng ký" Click="RegisterButton_Click" IsEnabled="False"
                                Background="{StaticResource BgLightBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                FontSize="14" FontWeight="SemiBold" Padding="20,10" BorderBrush="#C8C5BB" BorderThickness="1" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                                            CornerRadius="8" Padding="{TemplateBinding Padding}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{StaticResource BgDarkBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Status -->
                    <TextBlock x:Name="StatusText" Text="Trạng thái: Sẵn sàng kết nối" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    
                    <!-- Hidden Server IP Box so the code-behind still works -->
                    <TextBox x:Name="ServerIpBox" Text="127.0.0.1" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
